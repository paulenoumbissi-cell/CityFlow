# =================================================================
# CONFIGURATION DES PASSERELLES D'EXPÉDITION RÉELLES CITYFLOW
# =================================================================

PORT=3000

# -----------------------------------------------------------------
# 1. EXPÉDITION D'E-MAILS RÉELS (GMAIL / SMTP / BREVO)
# -----------------------------------------------------------------
# Exemple pour Gmail :
# 1. Allez sur votre compte Google -> Sécurité -> Validation en deux étapes
# 2. Générez un "Mot de passe d'application"
# 3. Renseignez les informations ci-dessous :
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre.email@gmail.com
SMTP_PASS=votre_mot_de_passe_application
SMTP_FROM=CityFlow Sécurité <votre.email@gmail.com>

# -----------------------------------------------------------------
# 2. EXPÉDITION SMS & WHATSAPP RÉELS (TWILIO / ORANGE)
# -----------------------------------------------------------------
# Identifiants Twilio (facultatif si vous avez un compte Twilio) :
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WA_NUMBER=

# Identifiants Meta WhatsApp Cloud API (facultatif) :
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
